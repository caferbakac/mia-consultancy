---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import type { Team as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  team = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  {
    team.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map(({ name, job, image, socials = [], description }) => (
          <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade rounded-lg border border-gray-100 bg-white p-6 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
            {image ? (
              <Image
                src={image.src}
                alt={image.alt || name || ''}
                width={160}
                height={160}
                format="webp"
                class="mx-auto mb-4 h-28 w-28 rounded-full object-cover"
              />
            ) : (
              <div class="bg-primary/10 text-primary mx-auto mb-4 flex h-28 w-28 items-center justify-center rounded-full text-2xl font-bold">
                {(name || '')
                  .split(' ')
                  .filter(Boolean)
                  .slice(0, 2)
                  .map((part) => part[0])
                  .join('')
                  .toUpperCase()}
              </div>
            )}
            {name && <h3 class="text-lg font-bold">{name}</h3>}
            {job && <p class="text-sm font-medium uppercase tracking-wide text-primary">{job}</p>}
            {description && <p class="text-muted mt-3 text-sm" set:html={description} />}
            {socials.length > 0 && (
              <div class="mt-4 flex justify-center gap-2">
                {socials.map(({ icon, href }) => (
                  <a
                    href={href}
                    class="text-muted hover:text-primary dark:hover:text-white inline-flex items-center rounded-lg p-2 hover:bg-gray-100 dark:hover:bg-slate-800"
                  >
                    {icon && <Icon name={icon} class="h-5 w-5" />}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    )
  }
</WidgetWrapper>
