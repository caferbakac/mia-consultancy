---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface Condition {
  title: string;
  quote: string;
  question: string;
  icon: string;
  color: 'primary' | 'secondary' | 'accent' | 'neutral';
}

export interface Step {
  title: string;
  description: string;
  icon: string;
  color: 'primary' | 'secondary' | 'accent' | 'neutral';
}

export interface Props {
  id?: string;
  title: string;
  titleHighlight?: string;
  subtitle?: string;
  conditions: Condition[];
  steps?: Step[];
  footnote?: string;
}

const { id, title, titleHighlight, subtitle, conditions = [], steps = [], footnote } = Astro.props as Props;

const tone: Record<Condition['color'], string> = {
  primary: 'var(--aw-color-primary)',
  secondary: 'var(--aw-color-secondary)',
  accent: 'var(--aw-color-accent)',
  neutral: 'var(--aw-color-text-heading)',
};
---

<WidgetWrapper id={id} containerClass="max-w-7xl mx-auto">
  <!-- Headline -->
  <div class="mb-10 md:mb-14 text-center">
    <div class="mx-auto mb-5 h-1 w-14 rounded-full bg-accent" aria-hidden="true"></div>
    <h2 class="font-bold font-heading leading-tighter tracking-tighter text-heading text-3xl md:text-4xl lg:text-5xl">
      {title}{titleHighlight && <span class="text-primary"> {titleHighlight}</span>}
    </h2>
    {subtitle && <p class="mt-4 mx-auto max-w-3xl text-lg md:text-xl text-muted">{subtitle}</p>}
  </div>

  <!-- The four conditions -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5 xl:gap-4">
    {
      conditions.map(({ title: label, quote, question, icon, color }) => (
        <div
          class="flex flex-col items-center justify-center rounded-3xl border-2 px-6 py-8 text-center xl:aspect-square xl:rounded-full xl:px-7 xl:py-6 xl:[min-height:min-content] intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          style={`--tone: ${tone[color]}; border-color: var(--tone); background-color: color-mix(in srgb, var(--tone) 7%, transparent);`}
        >
          <Icon name={icon} class="h-9 w-9" style="color: var(--tone);" aria-hidden="true" />
          <p class="mt-2.5 font-bold uppercase tracking-wide text-heading text-base lg:text-lg">{label}</p>
          <p class="mt-1 italic text-sm lg:text-base leading-snug" style="color: var(--tone);">
            &ldquo;{quote}&rdquo;
          </p>
          <span
            class="my-2.5 block h-px w-8"
            style="background-color: var(--tone); opacity: 0.45;"
            aria-hidden="true"
          />
          <p class="text-sm text-muted leading-snug text-pretty">{question}</p>
        </div>
      ))
    }
  </div>

  <!-- How the insight is used -->
  {
    steps.length > 0 && (
      <ol class="mt-12 md:mt-14 flex flex-col gap-6 border-t border-gray-200 pt-10 dark:border-slate-700 sm:grid sm:grid-cols-2 sm:gap-8 lg:flex lg:flex-row lg:items-start lg:justify-between lg:gap-2">
        {steps.map(({ title: label, description, icon, color }, index) => (
          <>
            <li
              class="flex flex-1 flex-col items-center text-center intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              style={`--tone: ${tone[color]};`}
            >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-full"
                style="background-color: color-mix(in srgb, var(--tone) 12%, transparent);"
                aria-hidden="true"
              >
                <Icon name={icon} class="h-6 w-6" style="color: var(--tone);" />
              </span>
              <p class="mt-3 font-bold uppercase tracking-wide text-heading text-sm">{label}</p>
              <p class="mt-1 max-w-[16rem] text-sm text-muted text-pretty">{description}</p>
            </li>
            {index < steps.length - 1 && (
              <li class="hidden lg:flex lg:shrink-0 lg:items-center lg:pt-5" aria-hidden="true">
                <Icon name="tabler:arrow-right" class="h-6 w-6 text-muted opacity-50" />
              </li>
            )}
          </>
        ))}
      </ol>
    )
  }

  {
    footnote && (
      <p class="mt-10 md:mt-12 border-t border-gray-200 pt-8 text-center text-base text-muted dark:border-slate-700 mx-auto max-w-4xl text-pretty">
        {footnote}
      </p>
    )
  }
</WidgetWrapper>
