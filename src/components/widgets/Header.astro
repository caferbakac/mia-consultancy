---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import LanguageSwitch from '~/components/common/LanguageSwitch.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, getPermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import { SITE } from 'astrowind:config';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Strip the site's base path before reasoning about `/tr` prefixes, then use
// getPermalink to add it back — the same base-aware helper every other link on
// the site already goes through. A no-op while `base` is `/`, but it keeps the
// toggle correct if the site is ever served from a subpath again.
const basePrefix = `/${trimSlash(SITE.base || '/')}`;
const relPath =
  basePrefix !== '/' && (currentPath === basePrefix || currentPath.startsWith(`${basePrefix}/`))
    ? currentPath.slice(basePrefix.length) || '/'
    : currentPath;

const isTrPage = relPath === '/tr' || relPath.startsWith('/tr/');
const targetRelPath = isTrPage
  ? relPath.replace(/^\/tr(\/.*)?$/, (_m, rest) => rest || '/')
  : relPath === '/'
    ? '/tr'
    : `/tr${relPath}`;
const langTogglePath = getPermalink(targetRelPath);
const langTarget = isTrPage ? 'en' : 'tr';
---

<aw-header transition:persist={isTrPage ? 'header-tr' : 'header-en'}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-3 px-3 xl:px-6 mx-auto w-full',
        {
          'xl:flex xl:justify-between': position !== 'center',
        },
        {
          'xl:grid xl:grid-cols-[1fr_auto_1fr] xl:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={isTrPage ? getPermalink('/tr') : getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center gap-1.5 sm:gap-2 xl:hidden">
          <LanguageSwitch href={langTogglePath} target={langTarget} compact class="gap-1 px-2 sm:gap-1.5 sm:px-3" />
          {
            actions?.length ? (
              <Button
                {...actions[0]}
                class="w-auto px-3.5 py-2 text-sm font-semibold shadow-none whitespace-nowrap sm:px-4"
              />
            ) : null
          }
          <ToggleMenu />
        </div>
      </div>
      <nav
        class="items-center w-full xl:w-auto hidden xl:flex xl:mx-5 text-default overflow-y-auto overflow-x-hidden xl:overflow-visible xl:justify-self-center"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-col xl:flex-row xl:self-center w-full xl:w-auto text-xl xl:text-[0.9375rem] tracking-[0.01rem] font-medium xl:justify-center"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class:list={[
                        'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                        { 'aw-link-active': links.some(({ href: childHref }) => childHref === currentPath) },
                      ]}
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden xl:inline"
                      />
                    </button>
                    <ul class="dropdown-menu xl:backdrop-blur-md dark:xl:bg-dark rounded xl:absolute pl-4 xl:pl-0 xl:hidden font-medium xl:bg-white/90 xl:min-w-[200px] drop-shadow-xl">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b xl:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                              { 'aw-link-active': href2 === currentPath },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden xl:self-center xl:flex items-center xl:mb-0 fixed w-full xl:w-auto xl:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] xl:p-0 xl:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full xl:w-auto">
          <div class="flex items-center">
            <LanguageSwitch href={langTogglePath} target={langTarget} class="mr-1 hidden xl:inline-flex" />
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 xl:w-5 xl:h-5 xl:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="ml-4 hidden rtl:ml-0 rtl:mr-4 xl:inline-block">
                {actions.map((btnProps) => (
                  <Button
                    {...btnProps}
                    class="ml-2 py-2.5 px-5.5 xl:px-6 font-semibold shadow-none text-sm w-auto whitespace-nowrap"
                  />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.updateLangToggle();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Close the mobile menu when a nav link is followed. Clicks on a
      // dropdown's parent label (a button, not a link) must leave it open.
      nav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement)?.closest('a')) closeMenu();
      });

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile breakpoint.
      this.mql = window.matchMedia('(max-width: 1279px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        a.classList.toggle('aw-link-active', norm(new URL(a.href).pathname) === current);
      });
      this.querySelectorAll<HTMLElement>('nav .dropdown').forEach((dropdown) => {
        const childActive = dropdown.querySelector('.dropdown-menu a.aw-link-active') !== null;
        dropdown.querySelector('button')?.classList.toggle('aw-link-active', childActive);
      });
    }

    // The header persists across view-transition navigations, so the
    // server-rendered language-toggle target/label would go stale when moving
    // between pages within the same language. Recompute from the live URL.
    private updateLangToggle() {
      const switches = this.querySelectorAll<HTMLAnchorElement>('[data-aw-lang-toggle]');
      if (!switches.length) return;

      // Vite replaces `import.meta.env.BASE_URL` at build time with the
      // configured `base` (currently `/`; a subpath would arrive as `/sub/`).
      const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
      let path = window.location.pathname.replace(/\/+$/, '') || '/';
      if (base && (path === base || path.startsWith(`${base}/`))) {
        path = path.slice(base.length) || '/';
      }

      const isTr = path === '/tr' || path.startsWith('/tr/');
      const target = isTr ? 'en' : 'tr';
      const name = isTr ? 'English' : 'Türkçe';
      let targetPath: string;
      if (isTr) {
        const rest = path.slice(3);
        targetPath = rest === '' ? '/' : rest;
      } else {
        targetPath = path === '/' ? '/tr' : `/tr${path}`;
      }
      const href = targetPath === '/' ? base || '/' : base + targetPath;

      switches.forEach((el) => {
        el.href = href;
        el.hreflang = target;
        el.lang = target;
        el.setAttribute('aria-label', name);
        el.title = name;
        const nameEl = el.querySelector('[data-lang-name]');
        if (nameEl) nameEl.textContent = name;
        const codeEl = el.querySelector('[data-lang-code]');
        if (codeEl) codeEl.textContent = target.toUpperCase();
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
