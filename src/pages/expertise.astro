---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import BarChart from '~/components/widgets/BarChart.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Core Competencies',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Core Competencies"
    title="Core Competencies"
    subtitle="Two areas, one discipline: understanding people through the moments that change them."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    columns={2}
    items={[
      {
        title: 'Elite Sport',
        description:
          'Supporting athletes, academies, coaches, and families through the psychological demands of development, performance, injury, and the transition to professional sport.',
        icon: 'tabler:ball-football',
      },
      {
        title: 'Organisations',
        description:
          'Helping organisations attract, integrate, and retain the next generation of professionals through evidence-based onboarding, leadership development, wellbeing, and organisational culture.',
        icon: 'tabler:building',
      },
    ]}
  />

  <!-- Content Widget **************** Elite Sport & Club Development ****** -->

  <Content
    isReversed
    title="Elite Sport & Club Development"
    items={[
      {
        title: 'Coach Development',
        description:
          'Supporting coaches in creating environments that promote autonomy, resilience, accountability, and long-term development through observation, feedback, and evidence-based practice.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Parent Engagement',
        description:
          'Helping families become effective partners in athlete development by providing practical guidance that strengthens support while reducing unnecessary performance pressure.',
        icon: 'tabler:users',
      },
      {
        title: 'Transition to Professional Sport',
        description:
          'Supporting athletes through one of the most demanding stages of their careers, from academy to senior football, with structured psychological preparation, adaptation, and ongoing support.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Injury Psychology & Rehabilitation',
        description:
          'Integrating psychological support into injury prevention and rehabilitation by helping athletes manage stress, maintain motivation, preserve team belonging, and confidently return to performance.',
        icon: 'tabler:first-aid-kit',
      },
      {
        title: 'International Player Integration',
        description:
          'Helping internationally recruited athletes adapt to new cultures, environments, and expectations so clubs can evaluate potential rather than the challenges of relocation.',
        icon: 'tabler:world',
      },
      {
        title: 'Release & Career Transition',
        description:
          'Supporting athletes before, during, and after deselection through identity development, career planning, education continuity, and structured transition programmes that prepare them for life beyond football.',
        icon: 'tabler:door-exit',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Young footballer training on the pitch',
    }}
  />

  <!-- Content Widget **************** Principles & Safeguarding ****** -->

  <Content
    isAfterContent
    title="Our Principles"
    items={[
      { description: 'We do not interfere with coaching decisions or tactical processes.' },
      { description: 'Psychological support remains independent from selection and performance evaluation.' },
      { description: 'Every intervention is tailored to the needs of the club and its athletes.' },
      { description: 'We prioritise long-term system development over one-off workshops.' },
      {
        title: 'Safeguarding',
        description:
          'Working with young athletes requires more than psychological expertise. It requires robust safeguarding systems. With nearly a decade of experience in child protection and mental health programming, we integrate safeguarding, referral pathways, confidentiality, and ethical data governance into every programme from the outset.',
        icon: 'tabler:shield-lock',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Team discussing governance and safeguarding practices',
    }}
  >
    <Fragment slot="content">
      <p>Our work is built on a number of non-negotiable principles:</p>
    </Fragment>
  </Content>

  <!-- BarChart Widget *************** Sport: value of development ****** -->

  <BarChart
    id="player-development-value"
    tagline="Elite Sport"
    title="Player development can create future financial value"
    subtitle="Current FIFA solidarity mechanism: 5% of eligible transfer compensation"
    axisLabel="Total solidarity pool (€m)"
    xAxisLabel="Illustrative eligible transfer fee"
    color="accent"
    max={2.5}
    ticks={[
      { value: 0, label: '0' },
      { value: 0.5, label: '0.5' },
      { value: 1, label: '1.0' },
      { value: 1.5, label: '1.5' },
      { value: 2, label: '2.0' },
      { value: 2.5, label: '2.5' },
    ]}
    bars={[
      { label: '€5m', value: 0.25, display: '€250k' },
      { label: '€10m', value: 0.5, display: '€500k' },
      { label: '€20m', value: 1, display: '€1m' },
      { label: '€50m', value: 2.5, display: '€2.5m' },
    ]}
    source="The 5% is distributed among eligible training clubs; an individual club receives its allocated share. Source: FIFA RSTP / Clearing House."
    summary="Developing a player is not only a sporting investment. When that player later moves for a fee, FIFA's solidarity mechanism returns 5% of it to the clubs that trained them, so a €10m transfer generates a €500k pool and a €50m transfer €2.5m. The clubs that keep young athletes progressing, and document that development properly, are the ones positioned to benefit."
  />

  <!-- Content Widget **************** Organizations: Problem ****** -->

  <Content
    isReversed
    tagline="Organizations"
    title="Integration and the New Generation"
    image={{
      src: 'https://images.unsplash.com/photo-1552581234-26160f608093?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Diverse team meeting in an office',
    }}
  >
    <Fragment slot="content">
      <p class="mb-4">
        Organisations often invest heavily in recruitment but lose talented people within the first years. The cost is
        not only financial; it appears in lost knowledge, reduced trust and the assumption that "this generation does
        not want to work."
      </p>
      <p class="mb-4">
        The reality is usually different. The challenge is often a gap between what organisations provide and what
        people need to sustain motivation: autonomy, meaningful development and belonging.
      </p>
      <p>
        The same applies to culturally diverse workplaces. Employees who are new to a country or organisational culture
        may struggle with unwritten rules around communication, relationships and expectations. When these differences
        are misunderstood, capable people can be unfairly perceived as disengaged or difficult.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Organizations: What we work on / don't do ****** -->

  <Content
    isAfterContent
    title="What We Work On"
    items={[
      {
        title: 'Intergenerational communication',
        description:
          'Supporting organisations to move beyond narratives such as "young people do not want to work," building two-way understanding between experienced employees and new-generation professionals, and helping teams recognise different expectations around communication, flexibility, purpose and career development.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Cross-cultural and migrant workforce integration',
        description:
          'Supporting organisations working with international and culturally diverse teams, exploring how workplace assumptions influence participation, evaluation and belonging, and helping both newcomers and receiving teams develop more inclusive practices.',
        icon: 'tabler:world',
      },
      {
        title: 'Psychological safety and retention',
        description:
          'Identifying early signs of disengagement before employees leave, understanding how workplace culture, leadership and belonging influence retention, and supporting organisations to build healthier and more sustainable team environments.',
        icon: 'tabler:heart',
      },
      {
        title: "What We Don't Do",
        description:
          'We are not an HR consultancy and do not provide employee engagement software or workplace therapy. Our role is to help organisations understand and strengthen the human processes behind integration, belonging and retention. Where clinical support is required, we help organisations establish appropriate referral pathways.',
        icon: 'tabler:info-circle',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Team collaborating around a table',
    }}
  />

  <!-- BarChart Widget *************** Organizations: cost of losing talent ****** -->

  <BarChart
    id="talent-replacement-cost"
    tagline="Organisations"
    title="Losing talent has a measurable cost"
    subtitle="Estimated replacement cost by role"
    axisLabel="Estimated replacement cost (% of annual salary)"
    color="primary"
    max={200}
    ticks={[
      { value: 0, label: '0' },
      { value: 50, label: '50' },
      { value: 100, label: '100' },
      { value: 150, label: '150' },
      { value: 200, label: '200' },
    ]}
    bars={[
      { label: 'Frontline employee', value: 40, display: '40%' },
      { label: 'Technical professional', value: 80, display: '80%' },
      { label: 'Leader / manager', value: 200, display: '200%' },
    ]}
    source="Source: Gallup. Estimates exclude unmeasured losses in morale and knowledge."
    summary="Replacing someone costs far more than most organisations account for: roughly 40% of annual salary for a frontline employee, 80% for a technical professional and up to 200% for a leader. Losing one young talent can therefore cost two full salaries, before counting the disruption to teams and the knowledge that leaves with them. Retention is not a soft concern; it is a budget line."
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Discuss your challenge',
        href: getPermalink('/contact'),
      },
    ]}
    title="Not sure where to start?"
    subtitle="Tell us about the people or organisation you're working with, and we'll help you scope the right engagement."
  />
</Layout>
