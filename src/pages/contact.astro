---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's talk about your challenge" />

  <ContactUs
    id="form"
    title="Tell us what you're working on"
    subtitle="Share a few details about your organization and the challenge you're facing, and we'll follow up to schedule an introductory call."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        required: true,
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        required: true,
      },
    ]}
    textarea={{
      label: 'How can we help?',
      required: true,
    }}
    disclaimer={{
      label:
        'By submitting this form, you acknowledge and agree to the collection of your personal information in line with our Privacy Policy.',
    }}
    description="We typically respond within one business day."
    mailto="sercan.erbecer@outlook.com"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to reach us"
    columns={3}
    items={[
      {
        title: 'Email',
        description: '<a class="hover:underline" href="mailto:hello@miaconsultancy.com">hello@miaconsultancy.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Türkiye',
        description: '<a class="hover:underline" href="tel:+905367381151">+90 536 738 11 51</a>',
        icon: 'tabler:phone',
      },
      {
        title: 'Global',
        description: '<a class="hover:underline" href="tel:+491785266603">+49 178 5266603</a>',
        icon: 'tabler:phone',
      },
    ]}
  />
</Layout>
