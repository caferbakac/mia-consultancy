---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation.tr';

import HeroText from '~/components/widgets/HeroText.astro';
import Team from '~/components/widgets/Team.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import sercanImg from '~/assets/images/team/sercan.jpg';
import isilImg from '~/assets/images/team/isil-square.jpg';
import caferImg from '~/assets/images/team/cafer.jpg';
import osmanImg from '~/assets/images/team/osman.jpg';
import sibelImg from '~/assets/images/team/sibel.jpg';
import mustafaImg from '~/assets/images/team/mustafa.jpeg';

const metadata = {
  title: 'Ekip',
};
---

<Layout metadata={metadata} lang="tr">
  <Header slot="header" {...headerData} isSticky showToggleTheme />

  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Ekip" title="Ekiple Tanışın" />

  <!-- Team Widget ******************* — Çekirdek Ekip ****** -->

  <Team
    tagline="Liderlik"
    title="Çekirdek Ekip"
    team={[
      {
        name: 'Mehmet Sercan Erbecer',
        job: 'Kurucu ve Ruh Sağlığı Uzmanı',
        image: { src: sercanImg, alt: 'Mehmet Sercan Erbecer' },
        socials: [{ icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/in/sercan-erbecer/' }],
      },
      {
        name: 'Işıl Özüak Tunca',
        job: 'Ruh Sağlığı Uzmanı ve Uygulamalı Psikolog',
        image: { src: isilImg, alt: 'Işıl Özüak Tunca' },
        socials: [
          {
            icon: 'tabler:brand-linkedin',
            href: 'https://www.linkedin.com/in/%C4%B1%C5%9F%C4%B1l-%C3%B6z%C3%BCak-tunca-b9bb5a82/',
          },
        ],
      },
      {
        name: 'Dr. Cafer Bakac',
        job: 'Araştırmacı ve Psikometrist',
        image: { src: caferImg, alt: 'Dr. Cafer Bakac' },
        socials: [
          { icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/in/cafer-bakac/' },
          { icon: 'tabler:world', href: 'https://caferbakac.github.io/' },
        ],
      },
    ]}
  />

  <!-- Team Widget ******************* — Geniş Ekip ****** -->

  <Team
    tagline="Destek"
    title="Geniş Ekip"
    team={[
      {
        name: 'Osman Yıldız',
        job: 'Psikososyal Destek Danışmanı',
        image: { src: osmanImg, alt: 'Osman Yıldız' },
      },
      {
        name: 'Sibel Afyon',
        job: 'Beslenme Uzmanı',
        image: { src: sibelImg, alt: 'Sibel Afyon' },
        socials: [{ icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/in/sibel-erbecer/' }],
      },
      {
        name: 'Mustafa Aslan',
        job: 'Doktora Araştırmacısı ve Veri Bilimci',
        image: { src: mustafaImg, alt: 'Mustafa Aslan' },
        socials: [
          { icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/in/aslanmu/' },
          { icon: 'tabler:world', href: 'https://mustafaslancoto.github.io/' },
        ],
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ekiple tanışın',
        href: '/tr/contact',
      },
    ]}
    title="Bizimle çalışmak ister misiniz?"
    subtitle="İster bir proje hakkında ister ekibe katılmak için olsun, sizinle konuşmaktan her zaman memnuniyet duyarız."
  />

  <Footer slot="footer" {...footerData} />
</Layout>
