---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation.tr';
import { getPermalink } from '~/utils/permalinks';

import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import WhatWeMeasure from '~/components/widgets/WhatWeMeasure.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Nasıl Çalışıyoruz?',
};
---

<Layout metadata={metadata} lang="tr">
  <Header slot="header" {...headerData} isSticky showToggleTheme />

  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Nasıl Çalışıyoruz?" title="Nasıl Çalışıyoruz?" />

  <!-- Features Widget *************** -->

  <Features
    columns={2}
    items={[
      {
        title: 'Tasarlamadan Önce Anlıyoruz',
        description:
          'Her iş birliğine varsayımlarla değil, anlamaya çalışarak başlıyoruz. Çözüm önermeden önce kurumunuza veya kişisel yolculuğunuza özgü güçlükleri, güçlü yönleri, destek kaynaklarını ve kritik geçiş dönemlerini inceliyoruz. Çünkü etkili çözümlerin hazır kalıplar üzerine değil, içinde bulunulan koşulların doğru anlaşılması üzerine kurulacağına inanıyoruz.',
        icon: 'tabler:search',
      },
      {
        title: 'Kritik Geçiş Dönemlerine Odaklanıyoruz',
        description:
          'İnsanlar çoğunlukla değişimin yaşandığı kritik dönemlerde zorlanır. Profesyonel hayata başlamak, liderlik rolü üstlenmek, yeni bir çevreye uyum sağlamak, yaşanan güçlüklerin ardından yeniden toparlanmak veya üst düzey performansa ilerlemek bu dönemlerden bazılarıdır. Desteğimizi en anlamlı ve güçlü etkiyi yaratabileceği noktalara odaklanarak sağlıyoruz.',
        icon: 'tabler:route',
      },
      {
        title: 'İç Kapasiteyi Güçlendiriyoruz',
        description:
          'Kalıcı değişim, günlük deneyimleri şekillendiren kişiler aracılığıyla gerçekleşir. İş birliğimiz sona erdikten sonra da devam edebilecek sürdürülebilir uygulamalar geliştirmek için liderler, yöneticiler, antrenörler, eğitimciler ve ekiplerle birlikte çalışıyoruz.',
        icon: 'tabler:users',
      },
      {
        title: 'Güveni Koruyoruz',
        description:
          'Psikolojik destek hiçbir zaman bir performans değerlendirme aracına dönüşmemelidir. Açık ve net etik sınırlar gözetiyor; kişisel bilgilerin gizliliğini koruyor ve psikolojik iyi oluş süreçlerini değerlendirme ve karar alma mekanizmalarından ayrı tutuyoruz.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Anlamlı Sonuçları Ölçüyoruz',
        description:
          'Her müdahaleyi bilimsel kanıtlar doğrultusunda şekillendiriyor ve anlamlı sonuçlar üzerinden değerlendiriyoruz. Ölçülebilir ve sürdürülebilir bir etki yaratabilmek için açık hedefler belirliyor, gelişimi izliyor ve yaklaşımımızı elde edilen bulgular doğrultusunda sürekli olarak geliştiriyoruz.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- WhatWeMeasure Widget ************** -->

  <WhatWeMeasure
    id="neyi-olcuyoruz"
    title="Neyi"
    titleHighlight="Ölçüyoruz?"
    subtitle="Başarılı geçişler yalnızca beceri ve deneyime bağlı değildir. İnsanların nasıl uyum sağladığını, geliştiğini ve performans gösterdiğini şekillendiren insani koşullara bakıyoruz."
    conditions={[
      {
        title: 'Özerklik',
        quote: 'Söz hakkım var',
        question: 'Kişiler söz hakkına, seçim özgürlüğüne ve sahiplenme duygusuna sahip olduklarını hissediyor mu?',
        icon: 'tabler:user',
        color: 'primary',
      },
      {
        title: 'Yetkinlik',
        quote: 'Bunun üstesinden gelebilirim',
        question: 'Kendilerinden beklenenleri karşılayacak yeterliliğe ve donanıma sahip olduklarını hissediyorlar mı?',
        icon: 'tabler:chart-bar',
        color: 'secondary',
      },
      {
        title: 'İlişkisellik',
        quote: 'Buraya aitim',
        question: 'Bağ kurduklarını, desteklendiklerini ve aidiyet duyduklarını hissediyorlar mı?',
        icon: 'tabler:users-group',
        color: 'accent',
      },
      {
        title: 'Netlik',
        quote: 'Bundan sonra ne olacağını biliyorum',
        question: 'Rollerini, kendilerinden beklenenleri ve bundan sonra ne olacağını anlıyorlar mı?',
        icon: 'tabler:compass',
        color: 'neutral',
      },
    ]}
    steps={[
      {
        title: 'Değerlendiriyoruz',
        description: 'Dinliyor, tabloyu çıkarıyor ve bir başlangıç noktası belirliyoruz.',
        icon: 'tabler:zoom',
        color: 'primary',
      },
      {
        title: 'Anlıyoruz',
        description: 'İhtiyaçları ve kritik geçiş noktalarını belirliyoruz.',
        icon: 'tabler:file-text',
        color: 'secondary',
      },
      {
        title: 'Destek Sunuyoruz',
        description: 'Hedefe yönelik çalışmalar tasarlıyoruz.',
        icon: 'tabler:settings',
        color: 'accent',
      },
      {
        title: 'Değişimi Ölçüyoruz',
        description: 'Anlamlı bir değişimin gerçekleşip gerçekleşmediğini yeniden değerlendiriyoruz.',
        icon: 'tabler:chart-bar',
        color: 'neutral',
      },
    ]}
    footnote="Bağlama göre psikolojik güvenlik, destek ağları, kimlik, geçişe hazır oluş ve beklentiler ile gerçeklik arasındaki farkı da inceliyoruz."
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Konuşmaya başlayın',
        href: getPermalink('/tr/contact'),
      },
    ]}
    title="Birlikte çalışmaya hazır mısınız?"
    subtitle="Her çalışma, nereye doğru ilerlediğiniz üzerine bir konuşmayla başlar."
  />

  <Footer slot="footer" {...footerData} />
</Layout>
