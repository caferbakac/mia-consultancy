---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation.tr';
import { getPermalink } from '~/utils/permalinks';

import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import BarChart from '~/components/widgets/BarChart.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Temel Yetkinlikler',
};
---

<Layout metadata={metadata} lang="tr">
  <Header slot="header" {...headerData} isSticky showToggleTheme />

  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Temel Yetkinlikler"
    title="Temel Yetkinlikler"
    subtitle="İki alan, tek disiplin: İnsanları, hayatlarını değiştiren anlar üzerinden anlamak."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    columns={2}
    items={[
      {
        title: 'Elit Spor',
        description:
          'Sporcuları, akademileri, koçları ve aileleri; gelişim, performans, sakatlık ve profesyonel spora geçiş süreçlerinin psikolojik gereksinimleri konusunda destekliyoruz.',
        icon: 'tabler:ball-football',
      },
      {
        title: 'Kurumlar',
        description:
          'Kurumların yeni nesil yetenekleri bünyesine çekmesine, hızla adapte etmesine ve uzun vadeli bağlılık oluşturmasına yardımcı oluyoruz. Bunu; kanıta dayalı işe alım, liderlik gelişimi, çalışan esenliği/iyi oluşu ve güçlü bir kurum kültürüyle başarıyoruz.',
        icon: 'tabler:building',
      },
    ]}
  />

  <!-- Content Widget **************** Elit Spor ve Kulüp Gelişimi ****** -->

  <Content
    isReversed
    title="Elit Spor ve Kulüp Gelişimi"
    items={[
      {
        title: 'Aile Katılımı',
        description:
          'Ailelerin, sporcu gelişiminde etkili birer yol arkadaşı olmalarını destekliyor; desteği güçlendiren ve gereksiz performans baskısını azaltan pratik rehberlik sunuyoruz.',
        icon: 'tabler:users',
      },
      {
        title: 'Profesyonel Spora Geçiş',
        description:
          'Sporcuların altyapıdan profesyonel futbola geçerken kariyerlerinin en zorlu dönemlerinden birini; yapılandırılmış psikolojik hazırlık, uyum çalışmaları ve sürekli destekle daha sağlıklı yönetmelerine yardımcı oluyoruz.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Sakatlık Psikolojisi ve Rehabilitasyon',
        description:
          'Psikolojik desteği sakatlıkların önlenmesi ve rehabilitasyon süreçlerine entegre ederek sporcuların stresle başa çıkmalarına, motivasyonlarını korumalarına, takıma aidiyetlerini sürdürmelerine ve sahaya güvenle dönmelerine yardımcı oluyoruz.',
        icon: 'tabler:first-aid-kit',
      },
      {
        title: 'Uluslararası Sporcuların Uyum Süreci',
        description:
          'Yurt dışından transfer edilen sporcuların yeni bir kültüre, yaşam düzenine ve performans beklentilerine uyum sağlamalarını destekliyoruz. Böylece uyum sürecinde yaşanan güçlüklerin sporcunun performansını ve potansiyelini gölgelemesini önleyerek kulüplerin daha sağlıklı ve gerçekçi bir değerlendirme yapmasına katkı sunuyoruz.',
        icon: 'tabler:world',
      },
      {
        title: 'Kadro Dışı Kalma ve Geçiş Süreci',
        description:
          'Sporcuları kadrodan ayrılma sürecinin öncesinde, sırasında ve sonrasında destekliyor; kimlik gelişimi, kariyer planlaması, eğitimin sürekliliği ve yapılandırılmış geçiş programları aracılığıyla futbol dışındaki yaşama hazırlıyoruz.',
        icon: 'tabler:door-exit',
      },
      {
        title: 'Koruma ve Güvenlik',
        description:
          'Genç sporcularla çalışmak, psikoloji alanındaki uzmanlığın ötesinde güçlü koruma sistemleri gerektirir. Çocuk koruma, çocuk güvenliği ve ruh sağlığı programlarında yaklaşık on yıllık deneyimimizle; koruma mekanizmalarını, yönlendirme süreçlerini, gizlilik ilkelerini ve etik veri yönetimini en başından itibaren tüm programlarımıza entegre ediyoruz.',
        icon: 'tabler:shield-lock',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Sahada antrenman yapan genç bir futbolcu',
    }}
  />

  <!-- Content Widget **************** İlkelerimiz ****** -->

  <Content
    isAfterContent
    title="İlkelerimiz"
    items={[
      { description: 'Koçluk kararlarına veya taktiksel süreçlere müdahale etmeyiz.' },
      { description: 'Psikolojik destek, seçim ve performans değerlendirmesinden bağımsız kalır.' },
      { description: 'Her müdahale, kulübün ve sporcularının ihtiyaçlarına göre uyarlanır.' },
      { description: 'Tek seferlik atölyeler yerine uzun vadeli sistem gelişimine öncelik veririz.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Yönetişim ve koruma uygulamalarını tartışan bir ekip',
    }}
  >
    <Fragment slot="content">
      <p>Çalışmalarımız, üzerinde taviz vermediğimiz bir dizi ilkeye dayanır:</p>
    </Fragment>
  </Content>

  <!-- BarChart Widget *************** Spor: gelisimin degeri ****** -->

  <BarChart
    id="oyuncu-gelisim-degeri"
    tagline="Elit Spor"
    title="Oyuncu gelişimi geleceğe dönük finansal değer yaratır"
    subtitle="Mevcut FIFA dayanışma mekanizması: uygun transfer bedelinin %5'i"
    axisLabel="Toplam dayanışma havuzu (milyon €)"
    xAxisLabel="Örnek uygun transfer bedeli"
    color="accent"
    max={2.5}
    ticks={[
      { value: 0, label: '0' },
      { value: 0.5, label: '0,5' },
      { value: 1, label: '1,0' },
      { value: 1.5, label: '1,5' },
      { value: 2, label: '2,0' },
      { value: 2.5, label: '2,5' },
    ]}
    bars={[
      { label: '5 mn €', value: 0.25, display: '250 bin €' },
      { label: '10 mn €', value: 0.5, display: '500 bin €' },
      { label: '20 mn €', value: 1, display: '1 mn €' },
      { label: '50 mn €', value: 2.5, display: '2,5 mn €' },
    ]}
    source="%5'lik pay, uygun tüm yetiştirme kulüpleri arasında paylaştırılır; her kulüp kendisine düşen payı alır. Kaynak: FIFA RSTP / Clearing House."
    summary="Bir oyuncuyu yetiştirmek yalnızca sportif bir yatırım değildir. Oyuncu ilerleyen dönemde bir bedelle transfer olduğunda, FIFA'nın dayanışma mekanizması bu bedelin %5'ini onu yetiştiren kulüplere geri kazandırır: 10 milyon avroluk bir transfer 500 bin avroluk, 50 milyon avroluk bir transfer ise 2,5 milyon avroluk bir havuz oluşturur. Genç sporcuların gelişimini sürdüren ve bu gelişimi usulüne uygun biçimde belgeleyen kulüpler, bu değerden yararlanabilecek konumdadır."
  />

  <!-- Content Widget **************** Entegrasyon ve Yeni Nesil ****** -->

  <Content
    isReversed
    tagline="Kurumlar"
    title="Entegrasyon ve Yeni Nesil"
    image={{
      src: 'https://images.unsplash.com/photo-1552581234-26160f608093?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Ofiste toplantı yapan çeşitli bir ekip',
    }}
  >
    <Fragment slot="content">
      <p class="mb-4">
        Kurumlar çoğu zaman işe alım süreçlerine önemli yatırımlar yapmasına rağmen yetenekli çalışanlarını daha ilk
        yıllarda kaybedebiliyor. Bunun bedeli yalnızca finansal değildir; kurumsal bilgi kaybı, güvenin azalması ve
        “Yeni nesil çalışmak istemiyor” gibi genelleyici yargıların güçlenmesiyle de kendini gösterir.
      </p>
      <p class="mb-4">
        Oysa gerçek çoğunlukla farklıdır. Sorun genellikle kurumların sunduklarıyla çalışanların motivasyonlarını
        sürdürebilmek için ihtiyaç duydukları özerklik, anlamlı gelişim olanakları ve aidiyet duygusu arasındaki
        uyumsuzluktan kaynaklanır.
      </p>
      <p>
        Benzer bir durum, kültürel çeşitliliğin bulunduğu çalışma ortamları için de geçerlidir. Yeni bir ülkeye ya da
        kurum kültürüne uyum sağlamaya çalışan çalışanlar; iletişim, ilişkiler ve beklentilerle ilgili yazılı olmayan
        kuralları anlamakta zorlanabilir. Bu farklılıklar doğru şekilde anlaşılmadığında, yetkin çalışanlar haksız
        biçimde ilgisiz, isteksiz ya da uyum sağlamakta güçlük çıkaran kişiler olarak değerlendirilebilir.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Ne Yapıyoruz? ****** -->

  <Content
    isAfterContent
    title="Ne Yapıyoruz?"
    items={[
      {
        title: 'Kuşaklar Arası İletişim',
        description:
          'Kurumların “Gençler çalışmak istemiyor” gibi genelleyici söylemlerin ötesine geçmelerine; deneyimli çalışanlarla yeni kuşak profesyoneller arasında karşılıklı anlayış geliştirmelerine destek oluyoruz. Ekiplerin iletişim, esneklik, amaç ve kariyer gelişimi konularındaki farklı beklentileri fark etmelerine ve bu farklılıkları daha sağlıklı biçimde yönetmelerine yardımcı oluyoruz.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Kültürler Arası Uyum ve Göçmen Çalışanların Entegrasyonu',
        description:
          'Uluslararası ve kültürel açıdan çeşitli ekiplerle çalışan kurumları destekliyor; iş yerindeki yerleşik varsayımların çalışanların katılımını, değerlendirilme biçimlerini ve aidiyet duygularını nasıl etkilediğini inceliyoruz. Hem yeni katılan çalışanların hem de onları karşılayan ekiplerin daha kapsayıcı çalışma pratikleri geliştirmelerine yardımcı oluyoruz.',
        icon: 'tabler:world',
      },
      {
        title: 'Psikolojik Güvenlik ve Çalışan Bağlılığı',
        description:
          'Çalışanlar kurumdan ayrılmadan önce ortaya çıkan motivasyon ve bağlılık kaybının erken işaretlerini belirliyor; iş yeri kültürünün, liderlik yaklaşımının ve aidiyet duygusunun çalışanların kurumda kalma kararları üzerindeki etkisini anlamaya odaklanıyoruz. Kurumların daha sağlıklı ve sürdürülebilir ekip ortamları oluşturmasına destek oluyoruz.',
        icon: 'tabler:heart',
      },
      {
        title: 'Ne Yapmıyoruz?',
        description:
          'Bir insan kaynakları danışmanlığı değiliz; çalışan bağlılığına yönelik yazılım çözümleri veya iş yeri kapsamında psikoterapi hizmeti sunmuyoruz. Rolümüz, kurumların uyum, aidiyet ve çalışanların kurumda kalma süreçlerinin ardındaki insani dinamikleri anlamalarına ve güçlendirmelerine yardımcı olmaktır. Klinik desteğe ihtiyaç duyulduğunda ise kurumların uygun yönlendirme mekanizmaları oluşturmasını destekliyoruz.',
        icon: 'tabler:info-circle',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Bir masa etrafında iş birliği yapan ekip',
    }}
  />

  <!-- BarChart Widget *************** Kurumlar: yetenek kaybinin maliyeti ****** -->

  <BarChart
    id="yetenek-kaybi-maliyeti"
    tagline="Kurumlar"
    title="Yetenek kaybının ölçülebilir bir maliyeti vardır"
    subtitle="Pozisyona göre tahmini devir maliyeti"
    axisLabel="Tahmini yerine koyma maliyeti (yıllık maaşın %'si)"
    color="primary"
    max={200}
    ticks={[
      { value: 0, label: '0' },
      { value: 50, label: '50' },
      { value: 100, label: '100' },
      { value: 150, label: '150' },
      { value: 200, label: '200' },
    ]}
    bars={[
      { label: 'Saha çalışanı', value: 40, display: '%40' },
      { label: 'Teknik uzman', value: 80, display: '%80' },
      { label: 'Lider / yönetici', value: 200, display: '%200' },
    ]}
    source="Kaynak: Gallup. Tahminler, moral ve kurumsal bilgi kaybı gibi ölçülemeyen etkileri içermez."
    summary={[
      'Bir çalışanın kaybını telafi etmek, çoğu kurumun öngördüğünden çok daha maliyetlidir: bu maliyet, saha çalışanlarında yıllık maaşın yaklaşık %40’ına, teknik uzmanlarda %80’ine, üst düzey yöneticilerde ise %200’üne kadar çıkabilir. Tek bir yöneticinin kurumdan ayrılması, ekiplerde yarattığı aksama ve beraberinde götürdüğü kurumsal bilgi birikimi hesaba katılmasa bile, iki yıllık maaşa eşdeğer bir maliyet yaratabilir.',
      'Bu nedenle çalışanları elde tutmak, doğrudan bütçeyi etkileyen somut bir iş meselesidir.',
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'İhtiyacınızı konuşalım',
        href: getPermalink('/tr/contact'),
      },
    ]}
    title="Nereden başlayacağınızdan emin değil misiniz?"
    subtitle="Birlikte çalıştığınız kişiler veya kurum hakkında bize bilgi verin, doğru çalışma kapsamını belirlemenize yardımcı olalım."
  />

  <Footer slot="footer" {...footerData} />
</Layout>
