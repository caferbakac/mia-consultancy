---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation.tr';
import { getPermalink } from '~/utils/permalinks';

import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SSS',
};
---

<Layout metadata={metadata} lang="tr">
  <Header slot="header" {...headerData} isSticky showToggleTheme />

  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="SSS"
    title="Sık Sorulan Sorular"
    subtitle="Görüşme talep eden müşterilerimizin en sık sorduğu soruların yanıtları."
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    tagline="Çalışma Süreci"
    title="Bizimle Çalışmak"
    columns={2}
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Hangi ölçekteki kurumlarla çalışıyorsunuz?',
        description:
          'Farklı sektörlerde faaliyet gösteren, büyüme sürecindeki ve orta ölçekli kurumların yanı sıra büyük kuruluşların belirli birimleriyle de çalışıyoruz.',
      },
      {
        title: 'Tipik bir iş birliği ne kadar sürüyor?',
        description:
          'Bu süre, çalışmanın kapsamına göre değişiyor. Belirli bir konuya odaklanan değerlendirme çalışması birkaç hafta sürebilirken, stratejinin oluşturulmasından uygulamaya kadar uzanan kapsamlı bir iş birliği genellikle birkaç ay devam ediyor. Çalışmaya başlamadan önce süreci ve zaman planını birlikte netleştiriyoruz.',
      },
      {
        title: 'Yalnızca danışmanlık mı sunuyorsunuz, uygulama sürecine de destek oluyor musunuz?',
        description:
          'Her ikisini de yapıyoruz. Planı kurumunuzla birlikte oluşturuyor, hayata geçirilmesini sağlamak için uygulama süreci boyunca ekibinizle yakın çalışmaya devam edebiliyoruz.',
      },
      {
        title: 'Sürekli danışmanlık yerine tek bir proje için sizinle çalışabilir miyiz?',
        description:
          'Evet. Çalışmalarımızın çoğu, kapsamı ve somut çıktıları açıkça tanımlanmış proje bazlı iş birlikleriyle başlıyor. Birbirimizi ve çalışma biçimimizi tanıdıktan sonra, ihtiyaç doğrultusunda sürekli danışmanlık modeliyle devam etmek de mümkün.',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    tagline="Süreç ve Gizlilik"
    title="Nasıl Çalışıyoruz?"
    columns={2}
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Bilgilerimizin gizliliğini nasıl koruyorsunuz?',
        description:
          'Her iş birliğine karşılıklı gizlilik sözleşmesi imzalayarak başlıyoruz. Kurumunuza ait bilgiler yalnızca ilgili projede doğrudan görev alan danışmanlarla paylaşılıyor.',
      },
      {
        title: 'Projemizde kimler görev alacak?',
        description:
          'Her projeyi kıdemli bir danışman yönetiyor ve ilk görüşmeden projenin tamamlanıp devredilmesine kadar tüm sürece doğrudan dâhil oluyor. Projeniz daha az deneyimli bir ekibe devredilmiyor.',
      },
      {
        title: 'Başarıyı nasıl ölçüyorsunuz?',
        description:
          'Her iş birliğinin başında açık, somut ve ölçülebilir başarı ölçütlerini birlikte belirliyoruz. İlerlemeyi yalnızca çalışmanın sonunda değil, süreç boyunca düzenli olarak değerlendiriyor ve raporluyoruz.',
      },
      {
        title: 'Çalışmaya nasıl başlayabiliriz?',
        description:
          'İletişim sayfamız üzerinden bize ulaşabilirsiniz. Çalışmanın kapsamını önermeden önce ihtiyaçlarınızı ve karşılaştığınız güçlükleri anlamak için bir ön görüşme planlıyoruz.',
        callToAction: {
          text: 'Bize ulaşın',
          href: getPermalink('/tr/contact'),
          icon: 'tabler:chevron-right',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Bize her şeyi sorun',
        href: getPermalink('/tr/contact'),
      },
    ]}
    title="Hâlâ sorularınız mı var?"
    subtitle="Kendi durumunuzu konuşmaktan memnuniyet duyarız."
  />

  <Footer slot="footer" {...footerData} />
</Layout>
