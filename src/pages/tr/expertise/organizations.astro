---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation.tr';
import { getPermalink } from '~/utils/permalinks';

import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import BarChart from '~/components/widgets/BarChart.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kurumlar',
  description:
    'Kurumların yeni nesil yetenekleri bünyesine çekmesine, hızla adapte etmesine ve uzun vadeli bağlılık oluşturmasına yardımcı oluyoruz.',
};
---

<Layout metadata={metadata} lang="tr">
  <Header slot="header" {...headerData} isSticky showToggleTheme />

  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Temel Yetkinlikler"
    title="Kurumlar"
    subtitle="Kurumların yeni nesil yetenekleri bünyesine çekmesine, hızla adapte etmesine ve uzun vadeli bağlılık oluşturmasına yardımcı oluyoruz. Bunu; kanıta dayalı işe alım, liderlik gelişimi, çalışan esenliği/iyi oluşu ve güçlü bir kurum kültürüyle başarıyoruz."
  />

  <!-- Content Widget **************** Entegrasyon ve Yeni Nesil ****** -->

  <Content
    isReversed
    title="Entegrasyon ve Yeni Nesil"
    image={{
      src: 'https://images.unsplash.com/photo-1552581234-26160f608093?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Ofiste toplantı yapan çeşitli bir ekip',
    }}
  >
    <Fragment slot="content">
      <p class="mb-4">
        Kurumlar çoğu zaman işe alım süreçlerine önemli yatırımlar yapmasına rağmen yetenekli çalışanlarını daha ilk
        yıllarda kaybedebiliyor. Bunun bedeli yalnızca finansal değildir; kurumsal bilgi kaybı, güvenin azalması ve
        “Yeni nesil çalışmak istemiyor” gibi genelleyici yargıların güçlenmesiyle de kendini gösterir.
      </p>
      <p class="mb-4">
        Oysa gerçek çoğunlukla farklıdır. Sorun genellikle kurumların sunduklarıyla çalışanların motivasyonlarını
        sürdürebilmek için ihtiyaç duydukları özerklik, anlamlı gelişim olanakları ve aidiyet duygusu arasındaki
        uyumsuzluktan kaynaklanır.
      </p>
      <p>
        Benzer bir durum, kültürel çeşitliliğin bulunduğu çalışma ortamları için de geçerlidir. Yeni bir ülkeye ya da
        kurum kültürüne uyum sağlamaya çalışan çalışanlar; iletişim, ilişkiler ve beklentilerle ilgili yazılı olmayan
        kuralları anlamakta zorlanabilir. Bu farklılıklar doğru şekilde anlaşılmadığında, yetkin çalışanlar haksız
        biçimde ilgisiz, isteksiz ya da uyum sağlamakta güçlük çıkaran kişiler olarak değerlendirilebilir.
      </p>
    </Fragment>
  </Content>

  <!-- Content Widget **************** Ne Yapıyoruz? ****** -->

  <Content
    isAfterContent
    title="Ne Yapıyoruz?"
    items={[
      {
        title: 'Kuşaklar Arası İletişim',
        description:
          'Kurumların “Gençler çalışmak istemiyor” gibi genelleyici söylemlerin ötesine geçmelerine; deneyimli çalışanlarla yeni kuşak profesyoneller arasında karşılıklı anlayış geliştirmelerine destek oluyoruz. Ekiplerin iletişim, esneklik, amaç ve kariyer gelişimi konularındaki farklı beklentileri fark etmelerine ve bu farklılıkları daha sağlıklı biçimde yönetmelerine yardımcı oluyoruz.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Kültürler Arası Uyum ve Göçmen Çalışanların Entegrasyonu',
        description:
          'Uluslararası ve kültürel açıdan çeşitli ekiplerle çalışan kurumları destekliyor; iş yerindeki yerleşik varsayımların çalışanların katılımını, değerlendirilme biçimlerini ve aidiyet duygularını nasıl etkilediğini inceliyoruz. Hem yeni katılan çalışanların hem de onları karşılayan ekiplerin daha kapsayıcı çalışma pratikleri geliştirmelerine yardımcı oluyoruz.',
        icon: 'tabler:world',
      },
      {
        title: 'Psikolojik Güvenlik ve Çalışan Bağlılığı',
        description:
          'Çalışanlar kurumdan ayrılmadan önce ortaya çıkan motivasyon ve bağlılık kaybının erken işaretlerini belirliyor; iş yeri kültürünün, liderlik yaklaşımının ve aidiyet duygusunun çalışanların kurumda kalma kararları üzerindeki etkisini anlamaya odaklanıyoruz. Kurumların daha sağlıklı ve sürdürülebilir ekip ortamları oluşturmasına destek oluyoruz.',
        icon: 'tabler:heart',
      },
      {
        title: 'Ne Yapmıyoruz?',
        description:
          'Bir insan kaynakları danışmanlığı değiliz; çalışan bağlılığına yönelik yazılım çözümleri veya iş yeri kapsamında psikoterapi hizmeti sunmuyoruz. Rolümüz, kurumların uyum, aidiyet ve çalışanların kurumda kalma süreçlerinin ardındaki insani dinamikleri anlamalarına ve güçlendirmelerine yardımcı olmaktır. Klinik desteğe ihtiyaç duyulduğunda ise kurumların uygun yönlendirme mekanizmaları oluşturmasını destekliyoruz.',
        icon: 'tabler:info-circle',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Bir masa etrafında iş birliği yapan ekip',
    }}
  />

  <!-- BarChart Widget *************** Kurumlar: yetenek kaybinin maliyeti ****** -->

  <BarChart
    id="yetenek-kaybi-maliyeti"
    title="Yetenek kaybının ölçülebilir bir maliyeti vardır"
    subtitle="Pozisyona göre tahmini devir maliyeti"
    axisLabel="Tahmini yerine koyma maliyeti (yıllık maaşın %'si)"
    color="primary"
    max={200}
    ticks={[
      { value: 0, label: '0' },
      { value: 50, label: '50' },
      { value: 100, label: '100' },
      { value: 150, label: '150' },
      { value: 200, label: '200' },
    ]}
    bars={[
      { label: 'Saha çalışanı', value: 40, display: '%40' },
      { label: 'Teknik uzman', value: 80, display: '%80' },
      { label: 'Lider / yönetici', value: 200, display: '%200' },
    ]}
    source="Kaynak: Gallup. Tahminler, moral ve kurumsal bilgi kaybı gibi ölçülemeyen etkileri içermez."
    summary={[
      'Bir çalışanın kaybını telafi etmek, çoğu kurumun öngördüğünden çok daha maliyetlidir: bu maliyet, saha çalışanlarında yıllık maaşın yaklaşık %40’ına, teknik uzmanlarda %80’ine, üst düzey yöneticilerde ise %200’üne kadar çıkabilir. Tek bir genç yeteneğin kaybedilmesi, ekiplerde yarattığı aksama ve beraberinde götürdüğü kurumsal bilgi birikimi hesaba katılmasa bile, iki yıllık maaşa eşdeğer bir maliyet yaratabilir.',
      'Bu nedenle çalışanları elde tutmak, doğrudan bütçeyi etkileyen somut bir iş meselesidir.',
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'İhtiyacınızı konuşalım',
        href: getPermalink('/tr/contact'),
      },
    ]}
    title="Nereden başlayacağınızdan emin değil misiniz?"
    subtitle="Birlikte çalıştığınız kişiler veya kurum hakkında bize bilgi verin, doğru çalışma kapsamını belirlemenize yardımcı olalım."
  />

  <Footer slot="footer" {...footerData} />
</Layout>
